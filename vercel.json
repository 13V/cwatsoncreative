{
  "redirects": [
    {
      "source": "/portfolio.html",
      "destination": "/gallery.html",
      "permanent": true
    },
    {
      "source": "/sessions.html",
      "destination": "/investment.html",
      "permanent": true
    },
    {
      "source": "/enquire.html",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
